,"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CapaRequest"}}},"required":true},"responses":{"200":{"description":"OK"}}}},"/api/admin/estabelecimentos/{estabelecimentoId}/servicos/{servicoId}":{"get":{"tags":["Serviços"],"summary":"Consultar serviço","description":"Consulta um serviço ativo pertencente ao estabelecimento.\n\nExige gestor autenticado e autorizado.\nServiços inexistentes ou desativados retornam 404.\n","operationId":"consultar","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"servicoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Serviço encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}},"401":{"description":"Não autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}},"403":{"description":"Acesso negado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}},"404":{"description":"Serviço não encontrado ou inativo","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}}}},"put":{"tags":["Serviços"],"summary":"Editar serviço","description":"Atualiza nome, duração e preço de um serviço ativo.\n\nExige gestor autenticado e autorizado.\nRequer cookie JSESSIONID e token CSRF válido.\n\nA edição não modifica o estabelecimento do serviço.\n","operationId":"editar_1","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"servicoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"X-CSRF-TOKEN","in":"header","description":"Token obtido em GET /api/auth/csrf","required":true}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ServicoRequestDTO"}}},"required":true},"responses":{"200":{"description":"Serviço atualizado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}},"400":{"description":"Dados inválidos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}},"401":{"description":"Não autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}},"403":{"description":"Acesso negado ou CSRF inválido","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}},"404":{"description":"Serviço não encontrado ou inativo","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}}}},"delete":{"tags":["Serviços"],"summary":"Desativar serviço","description":"Realiza exclusão lógica (soft delete) do serviço.\n\nO registro permanece no banco de dados, mas deixa\nde aparecer nas consultas de serviços ativos.\n\nExige gestor autenticado e autorizado.\nRequer cookie JSESSIONID e token CSRF válido.\n\nNão cancela automaticamente agendamentos existentes.\n","operationId":"desativar","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"servicoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"X-CSRF-TOKEN","in":"header","description":"Token obtido em GET /api/auth/csrf","required":true}],"responses":{"204":{"description":"Serviço desativado"},"401":{"description":"Não autenticado"},"403":{"description":"Acesso negado ou CSRF inválido"},"404":{"description":"Serviço não encontrado ou inativo"}}}},"/api/admin/estabelecimentos/{estabelecimentoId}/profissionais/{profissionalId}":{"get":{"tags":["profissional-controller"],"operationId":"consultar_1","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"profissionalId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProfissionalResponseDTO"}}}}}},"put":{"tags":["profissional-controller"],"operationId":"editar_2","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"profissionalId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProfissionalRequestDTO"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProfissionalResponseDTO"}}}}}},"delete":{"tags":["profissional-controller"],"operationId":"desativar_1","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"profissionalId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"204":{"description":"No Content"}}}},"/api/admin/estabelecimentos/{estabelecimentoId}/profissionais/{profissionalId}/disponibilidade":{"get":{"tags":["disponibilidade-controller"],"operationId":"consultar_2","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"profissionalId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DisponibilidadeResponseDTO"}}}}}},"put":{"tags":["disponibilidade-controller"],"operationId":"atualizar","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"profissionalId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DisponibilidadeRequestDTO"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DisponibilidadeResponseDTO"}}}}}}},"/api/estabelecimentos":{"post":{"tags":["Estabelecimentos"],"summary":"Cadastrar estabelecimento e gestor","description":"Cadastra um estabelecimento e seu gestor responsável.\n\nEndpoint público: não exige autenticação.\n\nExige proteção CSRF:\n1. Obtenha o token em GET /api/auth/csrf.\n2. Preserve o cookie JSESSIONID recebido.\n3. Envie o token no header X-CSRF-TOKEN.\n\nO campo imagemUrl é opcional.\nO upload de imagens será implementado futuramente.\n","operationId":"cadastrar","parameters":[{"name":"X-CSRF-TOKEN","in":"header","description":"Token obtido em GET /api/auth/csrf","required":true}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EstabelecimentoCadastroDTO"}}},"required":true},"responses":{"201":{"description":"Estabelecimento e gestor cadastrados"},"400":{"description":"Dados inválidos"},"403":{"description":"Token CSRF ausente ou inválido"},"409":{"description":"E-mail já cadastrado"}}}},"/api/estabelecimentos/{estabelecimentoId}/avaliacoes":{"get":{"tags":["Portal Público - Avaliações"],"summary":"Listar avaliações públicas","description":"Retorna as avaliações publicadas de um estabelecimento,\nordenadas da mais recente para a mais antiga.\n\nNão exige autenticação nem CSRF.\n","operationId":"listar","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Avaliações consultadas com sucesso","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AvaliacaoResponseDTO"}}}}},"404":{"description":"Estabelecimento não encontrado","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AvaliacaoResponseDTO"}}}}}}},"post":{"tags":["Avaliações - Cliente"],"summary":"Publicar avaliação","description":"Permite que um cliente autenticado avalie\num estabelecimento uma única vez.\n\nExige role CLIENTE e token CSRF válido.\n","operationId":"publicar","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AvaliacaoRequestDTO"}}},"required":true},"responses":{"201":{"description":"Avaliação publicada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AvaliacaoResponseDTO"}}}},"400":{"description":"Dados inválidos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AvaliacaoResponseDTO"}}}},"401":{"description":"Não autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AvaliacaoResponseDTO"}}}},"403":{"description":"Acesso negado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AvaliacaoResponseDTO"}}}},"404":{"description":"Estabelecimento não encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AvaliacaoResponseDTO"}}}},"409":{"description":"Avaliação já existente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AvaliacaoResponseDTO"}}}}}}},"/api/estabelecimentos/{estabelecimentoId}/agendamentos":{"post":{"tags":["Agendamentos"],"summary":"Registrar novo agendamento","description":"Efetiva a reserva no banco garantindo prevenção contra concorrência e sobreposição.","operationId":"registrar","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AgendamentoRequestDTO"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/AgendamentoResponseDTO"}}}}}}},"/api/clientes":{"post":{"tags":["cliente-controller"],"summary":"Cadastrar cliente","description":"Cadastra um novo cliente com nome completo, telefone,\ne-mail e senha.\n\nEndpoint público, sem autenticação.\nExige token CSRF válido e cookie de sessão correspondente.\n\nO cliente é criado com papel CLIENTE e sem vínculo\nobrigatório com um estabelecimento.\n\nApós o cadastro, o cliente pode se autenticar\npor POST /api/auth/login para confirmar seu agendamento.\n","operationId":"cadastrar_1","parameters":[{"name":"X-CSRF-TOKEN","in":"header","description":"Token obtido em GET /api/auth/csrf","required":true}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClienteCadastroDTO"}}},"required":true},"responses":{"201":{"description":"Cliente cadastrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ClienteResponseDTO"}}}},"400":{"description":"Dados inválidos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ClienteResponseDTO"}}}},"403":{"description":"Token CSRF ausente ou inválido","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ClienteResponseDTO"}}}},"409":{"description":"E-mail já cadastrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ClienteResponseDTO"}}}}}}},"/api/auth/login":{"post":{"tags":["Auth"],"summary":"Autenticar usuário","description":"Autentica utilizando e-mail e senha.\nExige token CSRF no header X-CSRF-TOKEN\ne o cookie de sessão correspondente.\nRetorna os dados do usuário autenticado.\n","operationId":"login","parameters":[{"name":"X-CSRF-TOKEN","in":"header","description":"Token obtido em GET /api/auth/csrf","required":true}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginDTO"}}},"required":true},"responses":{"200":{"description":"Login realizado com sucesso","content":{"*/*":{"schema":{"type":"object"}}}},"400":{"description":"Dados inválidos","content":{"*/*":{"schema":{"type":"object"}}}},"401":{"description":"Credenciais inválidas","content":{"*/*":{"schema":{"type":"object"}}}},"403":{"description":"Token CSRF ausente ou inválido","content":{"*/*":{"schema":{"type":"object"}}}}}}},"/api/admin/estabelecimentos/{estabelecimentoId}/servicos":{"get":{"tags":["Serviços"],"summary":"Listar serviços ativos","description":"Lista os serviços ativos do estabelecimento informado.\n\nExige gestor autenticado e autorizado.\nServiços desativados não são retornados.\n","operationId":"listar_1","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Lista de serviços ativos","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}}},"401":{"description":"Não autenticado","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}}},"403":{"description":"Acesso negado","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}}}}},"post":{"tags":["Serviços"],"summary":"Cadastrar serviço","description":"Cadastra um serviço no estabelecimento informado.\n\nExige autenticação com papel GESTOR e autorização\npara administrar o estabelecimento.\n\nRequer cookie JSESSIONID e token CSRF válido.\nO campo valor aceita zero, mas não valores negativos.\n","operationId":"criar","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"X-CSRF-TOKEN","in":"header","description":"Token obtido em GET /api/auth/csrf","required":true}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ServicoRequestDTO"}}},"required":true},"responses":{"201":{"description":"Serviço cadastrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}},"400":{"description":"Dados inválidos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}},"401":{"description":"Não autenticado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}},"403":{"description":"Acesso negado ou CSRF inválido","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}}}}},"/api/admin/estabelecimentos/{estabelecimentoId}/profissionais":{"get":{"tags":["profissional-controller"],"operationId":"listar_2","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ProfissionalResponseDTO"}}}}}}},"post":{"tags":["profissional-controller"],"operationId":"criar_1","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProfissionalRequestDTO"}}},"required":true},"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ProfissionalResponseDTO"}}}}}}},"/api/estabelecimentos/{estabelecimentoId}/servicos":{"get":{"tags":["Portal Público - Serviços"],"summary":"Listar serviços públicos","description":"Retorna somente os serviços ativos do estabelecimento,\nincluindo identificador, nome, duração e preço.\n\nNão exige autenticação nem CSRF.\n","operationId":"listar_3","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Lista de serviços ativos","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}}},"404":{"description":"Estabelecimento não encontrado","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}}}}}},"/api/estabelecimentos/{estabelecimentoId}/servicos/{servicoId}":{"get":{"tags":["Portal Público - Serviços"],"summary":"Consultar serviço público","description":"Consulta um serviço ativo que pertença ao\nestabelecimento informado.\n\nNão exige autenticação nem CSRF.\n","operationId":"consultar_3","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"servicoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Serviço encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}},"404":{"description":"Estabelecimento ou serviço não encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ServicoResponseDTO"}}}}}}},"/api/estabelecimentos/{estabelecimentoId}/servicos/{servicoId}/profissionais":{"get":{"tags":["Portal Público - Profissionais"],"summary":"Listar profissionais por serviço","description":"Retorna todos os profissionais de um estabelecimento que realizam um serviço específico. Endpoint público.","operationId":"listarPorServico","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"servicoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ProfissionalResponseDTO"}}}}}}}},"/api/estabelecimentos/{estabelecimentoId}/servicos/{servicoId}/disponibilidade":{"get":{"tags":["Portal Público - Horários"],"summary":"Consultar horários disponíveis","description":"Retorna horários livres no formato HH:mm. Se profissionalId for omitido, faz a união das agendas de todos os profissionais aptos.","operationId":"consultar_4","parameters":[{"name":"estabelecimentoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"servicoId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"data","in":"query","required":true,"schema":{"type":"string","format":"date"}},{"name":"profissionalId","in":"query","required":false,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"type":"string"}}}}}}}},"/api/estabelecimentos/{estabelecimentoId}/avaliacoes/resumo":{"get":{"tags":["Portal Público - Avaliações"],"summary":"Consultar resumo das avaliações","description":"Retorna a quantidade total de avaliações\